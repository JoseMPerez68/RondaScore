{
  "rules": {
    "m": {
      "$code": {
        ".read": "!data.exists() || data.child('exp').val() > now",
        ".write": "auth != null && (!data.exists() || data.child('o').val() === auth.uid || data.child('exp').val() < now)",
        ".validate": "$code.matches(/^[2-9A-HJ-NP-Z]{6}$/) && newData.hasChildren(['o', 'v', 's', 'exp', 'u', 'd'])",
        "o": { ".validate": "newData.val() === auth.uid" },
        "v": { ".validate": "newData.isNumber()" },
        "s": { ".validate": "newData.isString() && newData.val().matches(/^[apf]$/)" },
        "exp": { ".validate": "newData.isNumber() && newData.val() <= now + 691200000" },
        "u": { ".validate": "newData.val() === now" },
        "d": { ".validate": "newData.isString() && newData.val().length < 60000" },
        "$other": { ".validate": false }
      }
    }
  }
}
